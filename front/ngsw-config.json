{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.csr.html",
  "navigationRequestStrategy": "performance",
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/api/**",
    "!/admin",
    "!/admin/**"
  ],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.svg",
          "/index.csr.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/media/**",
          "/icons/**",
          "/images/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "recipe-images",
      "urls": [
        "/api/images/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxAge": "30d",
        "maxSize": 300
      }
    }
  ]
}
