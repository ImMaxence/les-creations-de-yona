# Local entry point of the whole application, as the Coolify proxy does in production:
# /api/* goes to the backend, everything else to the Angular SSR server.
:80 {
	handle /api/* {
		# The backend builds the Google return URL from the forwarded headers: without the port
		# (8000 here) it would send Google http://localhost/api/login/..., an unknown URL.
		reverse_proxy back:8080 {
			header_up X-Forwarded-Port {http.request.port}
		}
	}
	handle {
		reverse_proxy front:4000
	}
}
