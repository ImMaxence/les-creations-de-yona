# Copy to devops/.env and replace every "change-me" value.
# Never commit devops/.env.

# PostgreSQL
POSTGRES_DB=yona
POSTGRES_USER=yona
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# SeaweedFS (S3 API). Only the backend uses these credentials; the bucket stays private.
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=yona-images
S3_PORT=8333

# Google OAuth client (Google Cloud Console > Credentials > OAuth client ID > Web application).
# Authorized redirect URIs:
#   http://localhost:4200/api/login/oauth2/code/google   (Angular dev server proxying /api)
#   http://localhost:8080/api/login/oauth2/code/google   (backend alone)
#   http://localhost:8000/api/login/oauth2/code/google   (whole application in Docker, gateway)
#   https://les-creations-de-yona.fr/api/login/oauth2/code/google
# and, for the nightly Google Drive backups (back-office, Sauvegarde):
#   http://localhost:4200/api/admin/drive/callback
#   http://localhost:8080/api/admin/drive/callback
#   http://localhost:8000/api/admin/drive/callback
#   https://les-creations-de-yona.fr/api/admin/drive/callback
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

# Optional: contact given to the push services with each notification of a new recipe (VAPID "sub").
# PUSH_SUBJECT=https://les-creations-de-yona.fr

# Google accounts allowed into the back-office, comma-separated.
APP_ADMIN_EMAILS=change-me@gmail.com

# OpenAPI description (/api/docs) and Swagger UI, read by "npm run api:generate".
# Local only: leave unset in production, where the backend keeps them off.
API_DOCS_ENABLED=true

# Whole application in Docker (profile "app"), through the gateway.
APP_PORT=8000
