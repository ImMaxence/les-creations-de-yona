# Copy to devops/.env and replace every "change-me" value.
# Never commit devops/.env.

# PostgreSQL
POSTGRES_DB=yona
POSTGRES_USER=yona
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# SeaweedFS (S3 API). Only the backend uses these credentials; the bucket stays private.
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=yona-images
S3_PORT=8333

# Google OAuth client (Google Cloud Console > Credentials > OAuth client ID > Web application).
# Authorized redirect URIs:
#   http://localhost:4200/api/login/oauth2/code/google   (Angular dev server proxying /api)
#   http://localhost:8080/api/login/oauth2/code/google   (backend alone)
#   http://localhost:8000/api/login/oauth2/code/google   (whole application in Docker, gateway)
#   https://les-creations-de-yona.fr/api/login/oauth2/code/google
# and, for the nightly Google Drive backups (back-office, Sauvegarde):
#   http://localhost:4200/api/admin/drive/callback
#   http://localhost:8080/api/admin/drive/callback
#   http://localhost:8000/api/admin/drive/callback
#   https://les-creations-de-yona.fr/api/admin/drive/callback
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

# Optional: contact given to the push services with each notification of a new recipe (VAPID "sub").
# PUSH_SUBJECT=https://les-creations-de-yona.fr

# Optional: "Remplir avec l'IA" in the recipe editor (Gemini, free tier). Key created at
# https://aistudio.google.com/apikey, on a Google Cloud project without billing. Without it, the button is greyed out.
# GEMINI_API_KEY=
# Claude (Anthropic), paid per use: key from https://console.anthropic.com, model claude-haiku-5-5 by default
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5

# "Je ne suis pas un robot" of "Donner mon avis" (reCAPTCHA v2 checkbox).
# Local: keep these public test keys from Google (the box always passes, with a red warning on the widget).
# Production (Coolify, required): keys created at https://www.google.com/recaptcha/admin/create,
# type "Challenge (v2)", domain les-creations-de-yona.fr. Details in docs/google.md.
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# The first accounts of the back-office, comma-separated: created when there is none, each signs in once with the
# Google account of that address, then adds Microsoft or passkeys in "Mon compte". Ignored once an account exists.
APP_ADMIN_EMAILS=change-me@gmail.com
# When nobody can sign in any more: a link valid one hour for this admin, written in the logs at each start.
# APP_ADMIN_RECOVERY_EMAIL=
# Optional: "Se connecter avec Microsoft", personal accounts (portal.azure.com > Microsoft Entra ID > App registrations,
# "Personal Microsoft accounts only", Web redirect URIs as for Google, ending in /api/login/oauth2/code/microsoft).
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Passkeys belong to an address: http://localhost:8000 in Docker (set by compose.yaml). With npm start, put
# http://localhost:4200 first: PASSKEY_ORIGINS=http://localhost:4200,http://localhost:8000
# PASSKEY_ORIGINS=

# OpenAPI description (/api/docs) and Swagger UI, read by "npm run api:generate".
# Local only: leave unset in production, where the backend keeps them off.
API_DOCS_ENABLED=true

# Whole application in Docker (profile "app"), through the gateway.
APP_PORT=8000
